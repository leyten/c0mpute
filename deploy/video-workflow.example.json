    "20": {
      "class_type": "KSamplerAdvanced",
      "inputs": {
        "model": [
          "12",
          0
        ],
        "positive": [
          "5",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "latent_image": [
          "7",
          0
        ],
        "add_noise": "enable",
